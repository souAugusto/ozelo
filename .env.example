# Copy this file to .env and fill in your own project values.
# Never commit the real .env file.

# --- Supabase (public — safe to expose in the client bundle) -----------------
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- App -----------------------------------------------------------------
# Public base URL of the deployed web build (used as the Stripe redirect target).
EXPO_PUBLIC_APP_URL=https://ozelo.vercel.app

# ------------------------------------------------------------------------------
# The variables below are SECRET and are never read by the Expo app itself.
# They belong to the Supabase Edge Functions (supabase/functions/*) and must be
# set with `supabase secrets set` — do NOT prefix them with EXPO_PUBLIC_ and do
# NOT add them to the Vercel project's Environment Variables.
# ------------------------------------------------------------------------------

# --- Supabase (server-side, used by Edge Functions) --------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Stripe --------------------------------------------------------------
STRIPE_SECRET_KEY=sk_live_or_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_MONTHLY=price_...   # R$11,29/mês
STRIPE_PRICE_ANNUAL=price_...    # R$7,90/mês (cobrado anualmente)
APP_URL=https://ozelo.vercel.app

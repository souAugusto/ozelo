{
  "buildCommand": "npx expo export -p web",
  "outputDirectory": "dist",
  "framework": null,
  "routes": [
    { "src": "^/$", "dest": "/landing.html" },
    { "src": "^/termos/?$", "dest": "/termos.html" },
    { "src": "^/privacidade/?$", "dest": "/privacidade.html" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
